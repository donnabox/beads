+"""Owned-worker finite JSON/log scanner. Never imports product; no top-level IO."""
+import codecs,hashlib,json,math,re
+CHUNK=65536
+MARKER=4096
+REPORT=67108864
+RESULTS=16777216
+RAW=268435456
+class Refusal(RuntimeError):pass
+def need(ok,why):
+ if not ok:raise Refusal(why)
+def unique(pairs):
+ out={}
+ for k,v in pairs:
+  need(k not in out,'duplicate-json-key');out[k]=v
+ return out
+def invalid(_):raise Refusal('nonfinite-json')
+def strict_json(data,maximum):
+ need(type(data)is bytes and len(data)<=maximum,'json-byte-limit')
+ text=data.decode('utf-8','strict');n=len(text);i=0;nodes=0;deepest=0;largest=0
+ def ws():
+  nonlocal i
+  while i<n and text[i] in ' \r\n\t':i+=1
+ def string(key=False):
+  nonlocal i
+  need(i<n and text[i]=='"','json-string');start=i;i+=1
+  while i<n:
+   c=text[i];i+=1
+   if c=='"':return json.loads(text[start:i]) if key else None
+   need(ord(c)>=32,'json-control')
+   if c=='\\':
+    need(i<n,'json-escape');c=text[i];i+=1
+    if c=='u':need(i+4<=n and re.fullmatch('[a-fA-F0-9]{4}',text[i:i+4]) is not None,'json-unicode');i+=4
+    else:need(c in '"\\/bfnrt','json-escape')
+  raise Refusal('json-string-incomplete')
+ def value(depth):
+  nonlocal i,nodes,deepest,largest
+  ws();need(i<n,'json-value');nodes+=1;need(nodes<=1000000,'json-node-limit');c=text[i]
+  if c in '{[':
+   current=depth+1;deepest=max(deepest,current);need(current<=128,'json-depth-limit');i+=1;ws();entries=0;keys=set();end='}' if c=='{' else ']'
+   if i<n and text[i]==end:i+=1;return
+   while True:
+    if c=='{':
+     ws();key=string(True);need(key not in keys,'duplicate-json-key');keys.add(key);ws();need(i<n and text[i]==':','json-colon');i+=1
+    value(current);entries+=1;largest=max(largest,entries);need(entries<=100000,'json-container-limit');ws();need(i<n,'json-container-incomplete')
+    if text[i]==end:i+=1;return
+    need(text[i]==',','json-delimiter');i+=1
+  elif c=='"':string()
+  elif text.startswith('true',i):i+=4
+  elif text.startswith('false',i):i+=5
+  elif text.startswith('null',i):i+=4
+  else:
+   m=re.compile(r'-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?').match(text,i)
+   need(m is not None,'json-number');need(math.isfinite(float(m[0])),'nonfinite-json');i=m.end()
+ value(0);ws();need(i==n,'json-trailing')
+ # Tree allocation occurs only after the full bounded structural scan.
+ obj=json.loads(text,object_pairs_hook=unique,parse_constant=invalid)
+ actual_nodes=0;actual_depth=0;actual_entries=0
+ def count(v,depth):
+  nonlocal actual_nodes,actual_depth,actual_entries
+  actual_nodes+=1
+  if type(v) in [dict,list]:
+   actual_depth=max(actual_depth,depth+1);actual_entries=max(actual_entries,len(v))
+   for child in (v.values() if type(v)is dict else v):count(child,depth+1)
+  elif type(v) in [int,float]:need(math.isfinite(v),'nonfinite-json')
+ count(obj,0);need((nodes,deepest,largest)==(actual_nodes,actual_depth,actual_entries),'json-scan-parser-disagreement')
+ return obj
+class LogScanner:
+ def __init__(self,attempt):
+  self.attempt=attempt;self.offset=0;self.line_start=0;self.line_bytes=0;self.line=bytearray();self.skipped=False;self.markers=[];self.reports=[];self.utf8=codecs.getincrementaldecoder('utf-8')('strict');self.notifications=[];self.hash=hashlib.sha256()
+ def feed(self,data):
+  need(type(data)is bytes and len(data)<=CHUNK,'chunk-limit');self.offset+=len(data);need(self.offset<=RAW,'raw-log-limit');self.hash.update(data);self.utf8.decode(data)
+  cursor=0
+  while cursor<len(data):
+   newline=data.find(b'\n',cursor);end=len(data) if newline<0 else newline+1;part=data[cursor:end];cursor=end
+   self.line_bytes+=len(part)
+   if not self.skipped:self.line.extend(part)
+   if len(self.line)>REPORT:
+    candidate=bytes(self.line).lstrip(b' \t\r\n').startswith(b'{')
+    need(not candidate,'selected-line-limit');self.line.clear();self.skipped=True
+   if newline>=0:
+    if not self.skipped:self.consume(bytes(self.line),self.line_start)
+    self.line_start+=self.line_bytes;self.line_bytes=0;self.line.clear();self.skipped=False
+ def consume(self,line,start):
+  raw=line.strip(b' \t\r\n')
+  if not raw.startswith(b'{'):return
+  # Parse all bounded object lines before classification so reordered selected
+  # keys cannot bypass exact marker/report counts. Raw source bytes stay intact.
+  need(len(line)<=REPORT,'object-line-capacity');o=strict_json(raw,REPORT)
+  ismarker=type(o)is dict and o.get('observation')=='transactional-set-validation-phase'
+  isreport=type(o)is dict and o.get('kind')=='installed-valid-set-observation'
+  if not(ismarker or isreport):return
+  if ismarker:need(len(line)<=MARKER,'marker-byte-limit')
+  if ismarker:
+   need(type(o)is dict and set(o)=={'observation','version','attemptId','phase','sourceElapsedMilliseconds'},'marker-keys')
+   need(o['observation']=='transactional-set-validation-phase' and type(o['version'])is int and o['version']==1,'marker-identity')
+   need(type(self.attempt)is str and re.fullmatch('[a-f0-9]{32}',self.attempt) and o['attemptId']==self.attempt,'marker-attempt')
+   expected=['callback-start','callback-end'];need(len(self.markers)<2 and o['phase']==expected[len(self.markers)],'marker-order')
+   elapsed=o['sourceElapsedMilliseconds'];need(type(elapsed)in [int,float] and math.isfinite(elapsed) and 0<=elapsed<=120000,'marker-source-elapsed')
+   if self.markers:need(elapsed>=self.markers[0]['value']['sourceElapsedMilliseconds'],'marker-source-order')
+   item={'value':o,'offset':start,'bytes':len(line),'sha256':hashlib.sha256(line).hexdigest()};self.markers.append(item);self.notifications.append(o)
+  else:
+   need(type(o)is dict and o.get('kind')=='installed-valid-set-observation','report-identity');need(not self.reports,'duplicate-selected-report')
+   self.reports.append({'value':o,'offset':start,'bytes':len(line),'sha256':hashlib.sha256(line).hexdigest()})
+ def finish(self):
+  self.utf8.decode(b'',final=True);need(not self.line and not self.skipped,'incomplete-final-log-line');need(len(self.markers)==2 and len(self.reports)==1,'missing-phase-or-report')
+def file_json(path,maximum):
+ data=bytearray()
+ with path.open('rb') as f:
+  while True:
+   b=f.read(CHUNK)
+   if not b:break
+   data.extend(b);need(len(data)<=maximum,'json-file-limit')
+ return strict_json(bytes(data),maximum)
+def file_hash(path):
+ total=0;h=hashlib.sha256();before=path.stat()
+ with path.open('rb') as f:
+  while True:
+   b=f.read(CHUNK)
+   if not b:break
+   total+=len(b);h.update(b)
+ after=path.stat();need((before.st_ino,before.st_size,before.st_mtime_ns)==(after.st_ino,after.st_size,after.st_mtime_ns) and total==after.st_size,'file-grew-or-changed')
+ return {'sha256':h.hexdigest(),'bytes':total}
