+func newTerminalFixture(t *testing.T, failBuilder bool, cleanupFailed *bool) *terminalFixture {
+	t.Helper()
+	f := &terminalFixture{
+		listener:   &terminalListener{Listener: bufconn.Listen(64 << 10)},
+		observer:   &terminalObserved{newDone: make(chan struct{}), closed: make(chan struct{})},
+		acceptDone: make(chan struct{}), cleanupDone: make(chan struct{}),
+	}
+	// Installed before the factory starts the connection-watch sweeper.
+	t.Cleanup(func() {
+		if err := f.finish(); err != nil {
+			*cleanupFailed = true
+			t.Errorf("fixture cleanup incomplete: %v", err)
+		}
+	})
+	provider := memory.NewDBProvider(memory.NewDatabase("terminal_fixture"))
+	f.engine = sqle.NewDefault(provider)
+	if f.engine.Analyzer.Catalog.MySQLDb.Enabled() {
+		t.Fatal("fixture requires disabled MySQLDb")
+	}
+	builder := func(ctx context.Context, c *mysql.Conn, addr string) (sql.Session, error) {
+		f.observer.mu.Lock()
+		f.observer.builders++
+		f.observer.mu.Unlock()
+		if failBuilder {
+			return nil, errors.New("terminal fixture builder refused")
+		}
+		base := sql.NewBaseSessionWithClientServer(addr, sql.Client{User: c.User, Capabilities: c.Capabilities}, c.ConnectionID)
+		s := &terminalMemorySession{Session: memory.NewSession(base, provider)}
+		f.observer.mu.Lock()
+		f.observer.created = s
+		f.observer.mu.Unlock()
+		return s, nil
+	}
+	factory := func(ctx context.Context, opts ...sql.ContextOption) *sql.Context {
+		created := sql.NewContext(ctx, opts...)
+		f.observer.mu.Lock()
+		f.observer.factories++
+		f.observer.contextSessions = append(f.observer.contextSessions, created.Session)
+		f.observer.mu.Unlock()
+		return created
+	}
+	var err error
+	f.server, err = NewServerWithHandler(Config{Listener: f.listener}, f.engine, factory, builder, f.observer,
+		func(h mysql.Handler) (mysql.Handler, error) {
+			f.handler = h.(*Handler)
+			return &terminalHandler{Handler: h, o: f.observer}, nil
+		})
+	if err != nil {
+		t.Fatalf("construct real server: %v", err)
+	}
+	f.started = true
+	go func() { f.acceptErr = f.server.Start(); close(f.acceptDone) }()
+	return f
+}
+
+func (f *terminalFixture) dial(ctx context.Context) (net.Conn, error) {
+	first := false
+	f.dialOnce.Do(func() { first = true })
+	if !first {
+		return nil, errors.New("fixture permits exactly one dial attempt")
+	}
+	c, err := f.listener.DialContext(ctx)
+	if err != nil {
+		return nil, err
+	}
+	f.raw = &terminalTransport{Conn: c, closed: make(chan struct{})}
+	return f.raw, nil
+}
+
+func (f *terminalFixture) rawGreeting(t *testing.T) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), terminalIOBound)
+	defer cancel()
+	if _, err := f.dial(ctx); err != nil {
+		t.Fatalf("raw dial: %v", err)
+	}
+	if err := f.raw.SetDeadline(time.Now().Add(terminalIOBound)); err != nil {
+		t.Fatal(err)
+	}
+	terminalAwait(t, f.observer.newDone, "NewConnection/AddConn")
+	var header [4]byte
+	if _, err := io.ReadFull(f.raw, header[:]); err != nil {
+		t.Fatalf("greeting header: %v", err)
+	}
+	n := int(header[0]) | int(header[1])<<8 | int(header[2])<<16
+	if header[3] != 0 || n == 0 || n > 65536 {
+		t.Fatalf("greeting frame: %v", header)
+	}
+	body := make([]byte, n)
+	if _, err := io.ReadFull(f.raw, body); err != nil {
+		t.Fatalf("greeting body: %v", err)
+	}
+	if body[0] != 10 {
+		t.Fatalf("expected protocol10 greeting, got %d", body[0])
+	}
+}
