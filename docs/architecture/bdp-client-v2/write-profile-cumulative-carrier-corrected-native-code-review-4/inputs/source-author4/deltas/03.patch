+/** Private TX handoff capture only. Original hooks retain their original error path. */
+export function capturePrivateProfileHandoff<
+  T extends { result: unknown; sessions: unknown; baseline: unknown },
+>(
+  observed: T,
+  onObserved: ((value: T) => unknown) | undefined,
+  identity: { sourceCommit: string; entry: string },
+): { genuine: T | undefined; wrapperBytes: Uint8Array | undefined; refused: boolean } {
+  let genuine: T | undefined;
+  let refused = false;
+  try {
+    genuine = structuredClone(observed);
+  } catch {
+    refused = true;
+  }
+  // This invocation is deliberately outside every new-carrier catch, even after capture refusal.
+  const handoff = onObserved?.(observed);
+  let wrapperBytes: Uint8Array | undefined;
+  try {
+    if (!genuine || refused || !handoff) throw new Error("private carrier unavailable");
+    const fields = ownData(handoff, ["bytes", "rawWrapperSha256"]);
+    const bytes = copySourceBytes({ bytes: fields.bytes as Uint8Array }, "manifest", 4194304);
+    if (createHash("sha256").update(bytes).digest("hex") !== fields.rawWrapperSha256)
+      throw new Error("private carrier mismatch");
+    const parsed = ownData(parseBoundedJson(bytes, "manifest", "private-profile-report"), [
+      "sourceCommit",
+      "entry",
+      "result",
+      "sessions",
+      "baseline",
+      "supplemental",
+      "sequenceMemberSupplemental",
+      "principalSupplemental",
+      "conditionalSupplemental",
+    ]);
+    if (parsed.sourceCommit !== identity.sourceCommit || parsed.entry !== identity.entry)
+      throw new Error("private carrier identity");
+    for (const field of ["result", "sessions", "baseline"] as const)
+      if (
+        canonicalJson(JSON.parse(JSON.stringify(genuine[field]))) !== canonicalJson(parsed[field])
+      )
+        throw new Error("private carrier representation");
+    wrapperBytes = bytes;
+  } catch {
+    refused = true;
+  }
+  return { genuine, wrapperBytes, refused };
+}
 
