+  function begin() {
+    expect(++requests).toBeLessThanOrEqual(31);
+  }
+  function record(
+    method: string,
+    target: string,
+    status: number,
+    body: string,
+    headers: Record<string, string>,
+  ) {
+    records.push({
+      ordinal: requests,
+      method,
