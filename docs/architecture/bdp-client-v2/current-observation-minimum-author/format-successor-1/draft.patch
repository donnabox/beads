+      type: beadType,
+      properties: { n: 0 },
+    })),
+  });
+  const setBody = JSON.stringify({
+    collection: "beads",
+    selector: `$[?@.type == "${beadType}"]`,
+    cardinality: { min: 32, max: 32 },
+    change: [{ op: "replace", path: "/n", value: 1 }],
+  });
