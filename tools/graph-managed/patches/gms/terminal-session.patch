+func (f *terminalFixture) closeClient() error {
+	f.clientOnce.Do(func() {
+		if f.client != nil {
+			f.clientErr = f.client.Close()
+		}
+		if f.raw != nil {
+			f.clientErr = errors.Join(f.clientErr, f.raw.Close())
+		}
+	})
+	return f.clientErr
+}
+func (f *terminalFixture) closeServer() error {
+	f.serverOnce.Do(func() {
+		if f.server != nil {
+			f.serverErr = f.server.Close()
+		} else if f.handler != nil {
+			// The factory created a sweeper but returned no Server. This is
+			// the same single close owner, not an additional shutdown path.
+			f.handler.sm.connWatcher.Close()
+		}
+	})
+	return f.serverErr
+}
+func terminalWait(done <-chan struct{}, label string) error {
+	timer := time.NewTimer(terminalIOBound)
+	defer timer.Stop()
+	select {
+	case <-done:
+		return nil
+	case <-timer.C:
+		return fmt.Errorf("%s completion deadline", label)
+	}
+}
+func terminalAwait(t *testing.T, done <-chan struct{}, label string) {
+	t.Helper()
+	if err := terminalWait(done, label); err != nil {
+		t.Fatalf("invalid control (not an expected red): %v", err)
+	}
+}
+
+func (f *terminalFixture) finish() error {
+	f.cleanupOnce.Do(func() {
+		// The continuation owns f and every still-unfinished wait even if the
+		// caller's deadline expires. It never uses t from a background worker.
+		go func() { f.cleanupErr = f.cleanup(); close(f.cleanupDone) }()
+	})
+	f.finishOnce.Do(func() {
+		timer := time.NewTimer(12 * time.Second)
+		defer timer.Stop()
+		select {
+		case <-f.cleanupDone:
+			f.finishErr = f.cleanupErr
+		case <-timer.C:
+			f.finishErr = errors.New("cleanup ownership retained; completion not observed")
+		}
+	})
+	// Cleanup does not restart the caller's deadline or erase an earlier
+	// incomplete result if the continuation happens to finish afterward.
+	return f.finishErr
+}
+func (f *terminalFixture) cleanup() error {
+	result := f.listener.Close() // bufconn listener Close is guarded/idempotent.
+	result = errors.Join(result, f.closeClient())
+	interruptOwned := func() {
+		for _, c := range f.listener.transports() {
+			result = errors.Join(result, c.Close())
+		}
+		result = errors.Join(result, f.closeServer())
+	}
+	awaitOwned := func(done <-chan struct{}, label string) {
+		if err := terminalWait(done, label); err != nil {
+			result = errors.Join(result, err)
+			interruptOwned()
+			// An expired diagnostic deadline does not release ownership. This
+			// continuation retains all resources until the actual completion;
+			// finish reports its separate bounded wait as incomplete meanwhile.
+			<-done
+		}
+	}
+	if f.started {
+		awaitOwned(f.acceptDone, "accept loop")
+		result = errors.Join(result, f.acceptErr)
+	}
+	// The private listener has one permitted dial; after Accept exits this is
+	// the complete, stable set of accepted transports, including a handler
+	// that was launched but has not yet called NewConnection/AddConn.
+	accepted := f.listener.transports()
+	if len(accepted) > 0 {
+		awaitOwned(f.observer.newDone, "accepted AddConn")
+		awaitOwned(f.observer.closed, "terminal callback")
+		for _, c := range accepted {
+			awaitOwned(c.closed, "server transport close")
+		}
+		// No new accept/AddConn can race this point; delegate completion
+		// additionally covers SessionEnd and the map deletes after wg.Done.
+		f.server.SessionManager().WaitForClosedConnections()
+	}
+	result = errors.Join(result, f.closeServer())
+	if f.engine != nil {
+		result = errors.Join(result, f.engine.Close())
+	}
+	return result
+}
+
+// assertTerminal runs only after finish succeeds: acceptance has stopped and
+// AddConn, terminal delegate and transport-close completion are observed before
+// Wait. No live builder remains to acquire these observer/manager locks in reverse.
+func (f *terminalFixture) assertTerminal(t *testing.T, mode string) {
+	t.Helper()
+	o := f.observer
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	transports := len(f.listener.transports())
+	if o.connections != 1 || o.closedCalls != 1 || o.connectedEvents != 1 || o.disconnectedEvents != 1 || transports != 1 {
+		t.Fatalf("callback counts new=%d closed=%d connected=%d disconnected=%d transports=%d", o.connections, o.closedCalls, o.connectedEvents, o.disconnectedEvents, transports)
+	}
+	if o.queryEvents != 0 {
+		t.Fatalf("unexpected SQL query events: %d", o.queryEvents)
+	}
+	wantBuilders, wantAuth := 0, 0
+	if mode == "builder-error" || mode == "session-close" {
+		wantBuilders, wantAuth = 1, 1
+	}
+	if o.builders != wantBuilders {
+		t.Errorf("terminal builder count: got %d want %d", o.builders, wantBuilders)
+	}
+	if o.authenticated != wantAuth {
+		t.Errorf("authenticated callbacks: got %d want %d", o.authenticated, wantAuth)
+	}
+	if mode == "malformed-handshake" {
+		if len(o.aborts) != 1 || !strings.Contains(o.aborts[0], "Cannot parse client handshake response") || !strings.Contains(o.aborts[0], "only support protocol 4.1") {
+			t.Errorf("parser abort oracle: %v", o.aborts)
+		}
+	} else if mode == "builder-error" || mode == "session-close" {
+		if len(o.aborts) != 0 {
+			t.Errorf("unexpected ConnectionAborted: %v", o.aborts)
+		}
+	}
+	if mode == "builder-error" && (o.authErr == nil || !strings.Contains(o.authErr.Error(), "terminal fixture builder refused")) {
+		t.Errorf("authenticated builder error: %v", o.authErr)
+	}
+	if mode == "session-close" {
+		if o.authErr != nil {
+			t.Errorf("successful authentication callback returned: %v", o.authErr)
+		}
+		if o.created == nil || o.factories != 1 || len(o.contextSessions) != 1 || o.contextSessions[0] != o.created {
+			t.Fatal("cleanup did not use the exact existing session once")
+		}
+		o.created.mu.Lock()
+		events := strings.Join(o.created.events, ",")
+		commands := o.created.commands
+		o.created.mu.Unlock()
+		if events != "locks,end" || commands != 0 {
+			t.Errorf("session lifecycle events=%q commands=%d", events, commands)
+		}
+		f.watch.mu.Lock()
+		dead := f.watch.dead
+		f.watch.mu.Unlock()
+		if !dead {
+			t.Error("registered idle watcher was not retired")
+		}
+	} else if o.created != nil || o.factories != 0 {
+		t.Errorf("absent-session close created session/context: session=%v contexts=%d", o.created != nil, o.factories)
+	}
+	sm := f.server.SessionManager()
+	sm.mu.Lock()
+	sessions, connections := len(sm.sessions), len(sm.connections)
+	sm.mu.Unlock()
+	w := sm.connWatcher
+	w.mu.RLock()
+	watches := len(w.conns)
+	w.mu.RUnlock()
+	if sessions != 0 || connections != 0 || watches != 0 || len(sm.processlist.Processes()) != 0 {
+		t.Errorf("terminal maps sessions=%d connections=%d watches=%d", sessions, connections, watches)
+	}
+}
