+    attempt: `${options.base}.${options.profile}.profile.attempt.json`,
+    summary: `${options.base}.${options.profile}.profile.json`,
+  };
+  const owned = new Map<string, { dev: number; ino: number; bytes: number; digest: string }>();
+  const failure = () =>
+    Object.assign(new Error("private profile evidence persistence refused"), {
+      code: "persistence",
+    });
+  for (const destination of Object.values(paths)) {
+    try {
+      lstatSync(destination);
+      throw failure();
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw failure();
+    }
+  }
