+      method: "GET" | "HEAD" = "GET",
+      observed = true,
+      frames?: import("./transaction-batch.js").TransactionEvent[],
+    ) => {
+      begin(method, target, status);
+      const signal = new AbortController();
+      const stream = recordRawSse({
+        dial: active.listenUrl,
+        host: new URL(active.listenUrl).host,
