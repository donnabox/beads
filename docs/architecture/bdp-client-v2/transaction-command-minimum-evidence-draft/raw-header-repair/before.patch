+      const request = response.exactRequest;
+      const key = request?.headerLines.find(
+        (h) => h.name.toLowerCase() === "idempotency-key",
+      )?.value;
+      if (!active) {
+        if (response.url !== `${scope}operations/create-bead` || key !== "minimum-a") return;
+        active = true;
