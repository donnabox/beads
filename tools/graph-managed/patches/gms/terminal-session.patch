+const terminalIOBound = 2 * time.Second
+
+// Each control owns a separate engine/server/manager, but the stock constructors
+// and handlers still mutate process-global system/status registries. Engine
+// construction resets status values; handlers then update counters including
+// Connections, Aborted_connects and Max_used_connections. This test adds no
+// explicit counter reset or assertion. The stock status updater and client
+// cancellation watcher expose no join; this is not all-worker terminality.
+func TestTerminalConnectionIntegration(t *testing.T) {
+	for _, mode := range []string{"preauth-eof", "malformed-handshake", "builder-error", "session-close"} {
+		cleanupFailed := false
+		t.Run(mode, func(t *testing.T) {
+			f := newTerminalFixture(t, mode == "builder-error", &cleanupFailed)
+			if mode == "preauth-eof" || mode == "malformed-handshake" {
+				f.rawGreeting(t)
+				if mode == "malformed-handshake" {
+					// A complete four-byte flags word, with protocol41 absent.
+					// Header length=4, sequence=1; this reaches the parser rather
+					// than failing the transport's packet framing/read first.
+					packet := []byte{4, 0, 0, 1, 0, 0, 0, 0}
+					if n, err := f.raw.Write(packet); err != nil || n != len(packet) {
+						t.Fatalf("write malformed handshake: n=%d err=%v", n, err)
+					}
+					terminalAwait(t, f.observer.closed, "parser terminal callback")
+				}
+				if err := f.closeClient(); err != nil {
+					t.Fatalf("close raw client: %v", err)
+				}
+			} else {
+				err := f.connect(t)
+				if mode == "builder-error" {
+					if err == nil || !strings.Contains(err.Error(), "terminal fixture builder refused") {
+						t.Fatalf("expected builder error over real protocol, got %v", err)
+					}
+				} else {
+					if err != nil {
+						t.Fatalf("client connect: %v", err)
+					}
+					if f.client == nil {
+						t.Fatal("successful Connect returned no driver connection")
+					}
+					f.capturePublishedWatch(t)
+					if err := f.closeClient(); err != nil {
+						t.Fatalf("client COM_QUIT/close: %v", err)
+					}
+				}
+			}
+			if err := f.finish(); err != nil {
+				t.Fatalf("incomplete fixture cleanup (not an expected red): %v", err)
+			}
+			f.assertTerminal(t, mode)
+		})
+		if cleanupFailed {
+			// Keep ordinary assertion failures independent (including the
+			// deliberate unsafe controls), but never continue after a cleanup
+			// failure that may retain this fixture's unfinished ownership.
+			return
+		}
+	}
+}
