    "installedLocalRaw": {
      "availability": "wire available iff actualWireOctets>0; omitted optional status/hash never null invented; partial status is actual parsed prefix only",
      "cleanup": "actual source retains unknown runtime ownership; failed stage blocks immediate success audit/release",
      "optional": [
        "partialStatus",
        "actualWireSha256"
      ],
      "required": [
        "id",
        "transport",
        "method",
        "url",
        "credential",
        "state",
        "terminal",
        "partialWireAvailable",
        "actualWireOctets"
      ],
      "terminal": [
        "response",
        "abort",
        "timeout",
        "network",
        "bound",
        "incomplete"
      ]
    },
    "installedPublicRejected": {
      "acceptance": false,
      "required": [
        "id",
        "transport",
        "terminal",
        "errorClass"
      ],
      "terminal": "rejected"
    },
