load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "canonicalbatch",
    srcs = [
        "compile.go",
        "identity.go",
        "member.go",
        "query.go",
        "reference.go",
        "types.go",
    ],
    embedsrcs = ["query.schema.json"],
    importpath = "github.com/steveyegge/beads/internal/canonicalbatch",
    visibility = ["//:__subpackages__"],
    deps = [
        "//graphops",
        "//internal/clirevision",
        "//internal/graphpatch",
        "@com_github_santhosh_tekuri_jsonschema_v6//:jsonschema",
    ],
)

go_test(
    name = "canonicalbatch_test",
    srcs = [
        "compile_test.go",
        "identity_test.go",
    ],
    data = glob(["testdata/**"]),
    deps = [
        ":canonicalbatch",
        "//graphops",
    ],
)

