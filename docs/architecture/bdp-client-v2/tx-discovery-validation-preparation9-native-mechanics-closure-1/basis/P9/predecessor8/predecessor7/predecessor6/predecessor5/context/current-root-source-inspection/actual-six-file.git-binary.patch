+      }
+    console.log(
+      JSON.stringify({
+        observation: "D3-source",
+        callback: name,
+        elapsedMs: performance.now() - started,
+        workSettled,
+        cleanupKnown,
+        directories: directories.map((directory) => ({
+          directory,
+          absent: !existsSync(directory),
+        })),
+        observations,
+        failureCount: failures.length,
+      }),
+    );
+  }
