load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "intrinsictypecatalog",
    srcs = [
        "catalog.go",
        "source.go",
    ],
    embedsrcs = [
        "intrinsic-1.json",
        "intrinsic-2.json",
    ],
    importpath = "github.com/steveyegge/beads/internal/intrinsictypecatalog",
    visibility = ["//:__subpackages__"],
    deps = [
        "//graphops",
        "@com_github_santhosh_tekuri_jsonschema_v6//:jsonschema",
    ],
)

go_test(
    name = "intrinsictypecatalog_test",
    srcs = ["catalog_test.go"],
    embed = [":intrinsictypecatalog"],
    deps = ["//graphops"],
)

