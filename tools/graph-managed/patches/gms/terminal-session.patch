+func (f *terminalFixture) capturePublishedWatch(t *testing.T) {
+	t.Helper()
+	f.observer.mu.Lock()
+	c, expected := f.observer.conn, f.observer.created
+	f.observer.mu.Unlock()
+	if c == nil || expected == nil {
+		t.Fatal("no observed session")
+	}
+	sm := f.server.SessionManager()
+	sm.mu.Lock()
+	ci := sm.sessions[c.ConnectionID]
+	ok := ci != nil && ci.session == expected && ci.watch != nil
+	if ok {
+		f.watch = ci.watch
+	}
+	sm.mu.Unlock()
+	if !ok {
+		t.Fatal("published session/watch association missing")
+	}
+	w := sm.connWatcher
+	w.mu.RLock()
+	same := w.conns[c.ConnectionID] == f.watch && f.watch.conn == c
+	w.mu.RUnlock()
+	if !same {
+		t.Fatal("registered watch/connection identity mismatch")
+	}
+}
