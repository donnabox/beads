+    return await Promise.race([
+      promise,
+      new Promise<never>((_, reject) => {
+        timer = setTimeout(() => reject(new Error("D3 cleanup deadline")), remaining);
+      }),
+    ]);
+  } finally {
+    clearTimeout(timer);
