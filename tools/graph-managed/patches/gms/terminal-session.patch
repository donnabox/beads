+func (f *closeSessionFixture) assertNoCreation(builderCalls int) {
+	f.t.Helper()
+	if f.builderCalls != builderCalls {
+		f.t.Errorf("builder calls = %d, want %d", f.builderCalls, builderCalls)
+	}
+	if len(f.contexts) != 0 || len(f.tracer.names) != 0 || f.sm.lastPid != 0 || len(f.events) != 0 {
+		f.t.Error("absent cleanup invoked context, tracer, PID, or lock work")
+	}
+}
+
+func (f *closeSessionFixture) assertContext(sess sql.Session, query string) {
+	f.t.Helper()
+	if len(f.contexts) != 1 || len(f.optionCounts) != 1 || f.optionCounts[0] != 8 {
+		f.t.Fatalf("context/option counts = %d/%v, want one context with eight options", len(f.contexts), f.optionCounts)
+	}
+	ctx := f.contexts[0]
+	if ctx.Session != sess || ctx.Pid() != 1 || ctx.Query() != query || ctx.Memory != f.memory || ctx.ProcessList != f.processes || ctx.RootSpan() != f.tracer.span {
+		f.t.Fatal("context lost its captured session or ordinary options")
+	}
+	if ctx.Value(closeSessionTraceKey{}) != "traced" || len(f.tracer.names) != 1 || f.tracer.names[0] != "query" || f.sm.lastPid != 1 {
+		f.t.Fatal("context did not preserve tracing or PID allocation")
+	}
+}
