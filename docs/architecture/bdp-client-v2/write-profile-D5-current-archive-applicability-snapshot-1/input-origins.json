    "tx-report": {
      "anchors": [
        {
          "firstLineText": "Prepared the concrete cumulative execution boundary on the existing TX owner, not a new fused RU+TX owner. This packet enumerates all251 selected Historyfalse TX laws in canonical order:43Read,75Read+Update and133Transactional. It retains the17actual manifest owners as partial, marks234owners missing, and establishes zero complete laws. It authorizes no source, helper/schema evaluation, review or execution. All final runtime/configuration/acquisition identities are UNKNOWN.",
          "lines": [
            3
