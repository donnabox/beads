+// These controls exercise the actual terminal helper and bookkeeping separately.
+// They use only an Engine field literal, not its constructor or SQL execution.
+// They do not invoke ConnectionClosed: its deferred Engine.CloseSession requires
+// an initialized private pointer mutex.
+func TestCloseExistingSession(t *testing.T) {
+	t.Run("T1", func(t *testing.T) {
+		f := newCloseSessionFixture(t)
+		f.sm.connections[f.conn.ConnectionID] = f.conn
+		f.h.releaseExistingSessionLocks(f.conn)
+		f.assertNoCreation(0)
+		if f.sm.session(f.conn) != nil {
+			t.Fatal("terminal cleanup published a session")
+		}
+	})
+
+	t.Run("T2", func(t *testing.T) {
+		f := newCloseSessionFixture(t)
+		// Defensive synthetic state: NewSession normally publishes both fields
+		// under one mutex hold, so an observer cannot see this intermediate state.
+		ci := &connInfo{}
+		f.sm.sessions[f.conn.ConnectionID] = ci
+		f.h.releaseExistingSessionLocks(f.conn)
+		f.assertNoCreation(0)
+		if f.sm.sessions[f.conn.ConnectionID] != ci || ci.session != nil {
+			t.Fatal("terminal cleanup changed the synthetic empty entry")
+		}
+	})
+
+	t.Run("T3", func(t *testing.T) {
+		f := newCloseSessionFixture(t)
+		err := f.sm.NewSession(context.Background(), f.conn)
+		if err != f.builderErr {
+			t.Fatalf("builder error = %v, want original error", err)
+		}
+		f.h.releaseExistingSessionLocks(f.conn)
+		f.assertNoCreation(1)
+		if f.sm.session(f.conn) != nil || err != f.builderErr {
+			t.Fatal("failed builder was repaired or its original error was lost")
+		}
+	})
+
+	t.Run("T4", func(t *testing.T) {
+		f := newCloseSessionFixture(t)
+		original := f.session("original")
+		replacement := f.session("replacement")
+		ci := &connInfo{session: original}
+		f.sm.sessions[f.conn.ConnectionID] = ci
+		f.tracer.onStart = func() {
+			f.sm.mu.Lock()
+			ci.session = replacement
+			f.sm.mu.Unlock()
+		}
+
+		f.h.releaseExistingSessionLocks(f.conn)
+		f.assertContext(original, "")
+		if original.lockVisits != 1 || replacement.lockVisits != 0 {
+			t.Fatalf("lock visits original/replacement = %d/%d, want 1/0", original.lockVisits, replacement.lockVisits)
+		}
+		if got := strings.Join(f.events, ","); got != "trace,context,locks:original" {
+			t.Fatalf("cleanup events = %q", got)
+		}
+		// The tracer swap detects post-trace relookup. Exactly one lookup and
+		// the absence of check-then-create also require source review.
+	})
+
+	t.Run("T5", func(t *testing.T) {
+		f := newCloseSessionFixture(t)
+		sess := f.session("built")
+		f.built = sess
+		ctx, watch, err := f.sm.newContextAndWatch(context.Background(), f.conn, "fixture-query")
+		if err != nil || watch != nil || ctx == nil {
+			t.Fatalf("ordinary context = %v, watch = %v, error = %v", ctx, watch, err)
+		}
+		if f.builderCalls != 1 || f.sm.session(f.conn) != sess {
+			t.Fatal("ordinary path did not build and register its session")
+		}
+		if sess.setIDs != 1 || sess.id != f.conn.ConnectionID || sess.loggerGets != 1 || sess.loggerSets != 1 || sess.logger == nil {
+			t.Fatal("ordinary session ID/logger initialization was not preserved")
+		}
+		f.assertContext(sess, "fixture-query")
+
+		// Exercise the retained tracer and KillConnection service with test
+		// objects only. LoadInfile's bound method is checked in source review;
+		// this control must not send a protocol request or read a file.
+		f.tracer.onStart = nil
+		_, traced := ctx.Span("fixture-probe")
+		if traced == nil || len(f.tracer.names) != 2 || f.tracer.names[1] != "fixture-probe" {
+			t.Fatal("context did not retain its tracer")
+		}
+		f.sm.connections[f.conn.ConnectionID] = f.conn
+		if err := ctx.KillConnection(f.conn.ConnectionID); err != nil || f.transport.closes != 1 {
+			t.Fatalf("retained KillConnection service: error %v, closes %d", err, f.transport.closes)
+		}
+	})
+
+	t.Run("T6", func(t *testing.T) {
+		f := newCloseSessionFixture(t)
+		f.sm.AddConn(f.conn)
+		f.h.releaseExistingSessionLocks(f.conn)
+		f.sm.RemoveConn(f.conn)
+		f.sm.WaitForClosedConnections()
+		f.assertNoCreation(0)
+		if len(f.processes.added) != 1 || f.processes.added[0] != f.conn.ConnectionID || len(f.processes.removed) != 1 || f.processes.removed[0] != f.conn.ConnectionID {
+			t.Fatal("single-close process accounting was not paired")
+		}
+		if f.processes.addr != "component-test" || len(f.sm.connections) != 0 || len(f.sm.sessions) != 0 {
+			t.Fatal("single-close bookkeeping was not removed")
+		}
+		// No duplicate-close, query join, or SessionEnd completion is inferred.
+	})
+
+	t.Run("T7", func(t *testing.T) {
+		f := newCloseSessionFixture(t)
+		sess := f.session("existing")
+		f.sm.sessions[f.conn.ConnectionID] = &connInfo{session: sess}
+		f.h.releaseExistingSessionLocks(f.conn)
+		f.assertContext(sess, "")
+		if sess.lockVisits != 1 || sess.ends != 0 || f.builderCalls != 0 {
+			t.Fatal("existing cleanup did not visit locks once without creating or ending a session")
+		}
+		if got := strings.Join(f.events, ","); got != "trace,context,locks:existing" {
+			t.Fatalf("existing cleanup order = %q", got)
+		}
+		// Empty named/table maps exercise the real release bodies; they do not
+		// prove table identity, nonempty lock release, or cleanup-debt handling.
+	})
+
+	t.Run("T8", func(t *testing.T) {
+		f := newCloseSessionFixture(t)
+		before := f.session("before")
+		after := f.session("after")
+		ci := &connInfo{session: before}
+		f.sm.sessions[f.conn.ConnectionID] = ci
+		f.tracer.onStart = func() {
+			f.sm.mu.Lock()
+			ci.session = after
+			f.sm.mu.Unlock()
+		}
+		ctx, watch, err := f.sm.newContextAndWatch(context.Background(), f.conn, "ordered-query")
+		if err != nil || watch != nil || ctx == nil || ctx.Session != after {
+			t.Fatal("ordinary context must read its session after the tracer callback")
+		}
+		f.assertContext(after, "ordered-query")
+		if f.builderCalls != 0 {
+			t.Fatal("ordinary existing-session path invoked the builder")
+		}
+
+		// The same callback must not change terminal cleanup's earlier capture.
+		ci.session = before
+		closedCtx, found := f.sm.existingContextForClose(context.Background(), f.conn)
+		if !found || closedCtx == nil || closedCtx.Session != before || ci.session != after {
+			t.Fatal("terminal context did not retain its pre-trace session")
+		}
+		if f.builderCalls != 0 || len(f.contexts) != 2 || len(f.tracer.names) != 2 || f.sm.lastPid != 2 {
+			t.Fatal("trace/read ordering introduced extra construction")
+		}
+	})
+}
