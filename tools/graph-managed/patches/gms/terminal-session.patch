+func newCloseSessionFixture(t *testing.T) *closeSessionFixture {
+	t.Helper()
+	f := &closeSessionFixture{
+		t:          t,
+		transport:  &closeSessionConn{},
+		processes:  &closeSessionProcesses{},
+		memory:     &sql.MemoryManager{},
+		builderErr: errors.New("component builder failed"),
+	}
+	f.conn = &mysql.Conn{ConnectionID: 17, Conn: f.transport}
+	_, span := sql.NoopTracer.Start(context.Background(), "fixture")
+	f.tracer = &closeSessionTracer{span: span, events: &f.events}
+	f.sm = NewSessionManager(
+		func(ctx context.Context, opts ...sql.ContextOption) *sql.Context {
+			f.events = append(f.events, "context")
+			created := &sql.Context{Context: ctx}
+			created.ApplyOpts(opts...)
+			f.contexts = append(f.contexts, created)
+			f.optionCounts = append(f.optionCounts, len(opts))
+			return created
+		},
+		func(context.Context, *mysql.Conn, string) (sql.Session, error) {
+			f.builderCalls++
+			if f.built != nil {
+				return f.built, nil
+			}
+			return nil, f.builderErr
+		},
+		f.tracer, nil, f.memory, f.processes, "component-server",
+	)
+	f.h = &Handler{
+		sm: f.sm,
+		e: &sqle.Engine{
+			LS:       sql.NewLockSubsystem(),
+			Analyzer: &analyzer.Analyzer{Catalog: &analyzer.Catalog{}},
+		},
+	}
