+  expect(typeof raw).toBe("string");
+  const key = name === "manifest" ? "scenarios" : "rows";
+  const prefix = `"${key}": [\n    ${raw},\n`;
+  expect(text.includes(prefix), "principal-first-object").toBe(true);
+  const parent = text.replace(prefix, `"${key}": [\n`);
