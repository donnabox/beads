+  expect(reads).toBe(0);
+  expect(wait).not.toHaveBeenCalled();
+  console.log(
+    JSON.stringify({
+      observation: "finite-event-minimum-preflight",
+      label,
+      serviceCalls: 1,
+      clockCalls: now.mock.calls.length,
+      ownerReads: reads,
+      waits: wait.mock.calls.length,
+    }),
+  );
+});
