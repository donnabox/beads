load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "scenarios_lib",
    srcs = [
        "assert.go",
        "jsonpath.go",
        "main.go",
        "normalize.go",
        "receipts.go",
        "runner.go",
        "scenario.go",
        "workspace.go",
    ],
    importpath = "github.com/steveyegge/beads/scripts/scenarios",
    visibility = ["//visibility:private"],
    deps = ["//cmd/bd/protocol"],
)

go_binary(
    name = "scenarios",
    embed = [":scenarios_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "scenarios_test",
    srcs = [
        "assert_test.go",
        "fakebd_test.go",
        "jsonpath_test.go",
        "manifest_test.go",
        "normalize_test.go",
        "run_test.go",
        "shipped_test.go",
        "workspace_test.go",
    ],
    embed = [":scenarios_lib"],
)
