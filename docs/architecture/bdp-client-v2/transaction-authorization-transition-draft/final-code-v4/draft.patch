+      checkpoint: page.page.groups[0]?.checkpoint,
+      position: "pos-1",
+      previousPosition: "pos-0",
+      projectionAdvance: true,
+      changes: [],
+      erasures: [],
+      eventCount: 0,
+      events: [],
+    },
+  ]);
+  expect(page.page.groups[0]?.checkpoint).not.toBe("genesis");
+  expect(f.owner.inspect().resources).toHaveLength(1);
+  await service.close();
+});
