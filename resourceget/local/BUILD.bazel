load("@rules_go//go:def.bzl", "go_library", "go_test")

# The standalone consumer has its own module and manually maintained BUILD.
# gazelle:exclude testdata

go_library(
    name = "local",
    srcs = ["open.go"],
    importpath = "github.com/steveyegge/beads/resourceget/local",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/httpapi/graphread",
        "//internal/storage/graphstore",
        "//resourceget",
    ],
)

go_test(
    name = "local_test",
    srcs = [
        "existing_workspace_test.go",
        "open_test.go",
    ],
    data = ["//resourceget/local/testdata/consumer"],
    embed = [":local"],
    env = {"BEADS_RESOURCEGET_CONSUMER": "$(rlocationpath //resourceget/local/testdata/consumer)"},
    deps = [
        "//internal/storage/graphstore",
        "//internal/testutil/bazeltest",
        "//issueops",
        "//resourceget",
        "@com_github_go_sql_driver_mysql//:mysql",
    ],
)

