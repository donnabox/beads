    name = "resourcequery",
    srcs = [
        "admit.go",
        "api.go",
        "current_edition.go",
        "decode.go",
        "evaluate.go",
        "resource.go",
        "values.go",
        "walk.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/resourcequery",
    visibility = ["//:__subpackages__"],
    deps = ["//graphops"],
)

go_test(
    name = "resourcequery_test",
    srcs = [
        "admission_test.go",
        "current_edition_test.go",
        "query_test.go",
    ],
    embed = [":resourcequery"],
    deps = ["//graphops"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(["**/*.go"]),
    visibility = ["//:__subpackages__"],
)

