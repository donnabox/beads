+      f.run("a");
+      const config = f.owner.readConfiguration();
+      instance = f.service({
+        budgetMs: label === "invalid-policy" ? 0 : 2,
+        now: () => {
+          clocks++;
+          if (label === "throwing-clock") throw clockError;
+          return label === "nonfinite-clock" ? Number.NaN : 0;
