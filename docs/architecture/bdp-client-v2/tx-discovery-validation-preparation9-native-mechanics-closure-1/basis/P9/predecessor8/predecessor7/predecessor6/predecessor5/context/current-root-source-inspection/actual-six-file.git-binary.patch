+  }
+  async function commit(name = "a") {
+    const previous = measure;
+    measure = false;
+    try {
+      const result = await service.submit({
+        carrier: { kind: "batch" },
+        body: batch([create(name)]),
+        key: `d3_${name}`,
+        authorization: { kind: "authorized", principal: "writer" },
+        receiving: { acceptsJson: true, maximumOperations: 32 },
