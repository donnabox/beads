+}
+function filePath(value: unknown): string {
+  if (
+    typeof value !== "string" ||
+    !value.length ||
+    !value.isWellFormed() ||
+    !path.isAbsolute(value) ||
+    /\p{Cc}/u.test(value) ||
+    Buffer.byteLength(value) > 16384
+  )
