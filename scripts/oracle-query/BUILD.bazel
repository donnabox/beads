load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "oracle-query_lib",
    srcs = ["main.go"],
    importpath = "github.com/steveyegge/beads/scripts/oracle-query",
    visibility = ["//visibility:private"],
    deps = ["//internal/replay/oracle"],
)

go_binary(
    name = "oracle-query",
    embed = [":oracle-query_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "oracle-query_test",
    srcs = ["cli_test.go"],
    data = glob(["testdata/**"]),
    embed = [":oracle-query_lib"],
    deps = ["//internal/testutil/bazeltest"],
)

# --- begin go_srcs (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
    ),
    visibility = ["//:__subpackages__"],
)

# --- end go_srcs ---
