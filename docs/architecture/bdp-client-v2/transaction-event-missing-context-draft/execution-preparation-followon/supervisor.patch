+def verify_prior(source):
+    p = P / "prior-evidence.json"
+    require(sha(p.read_bytes()) == PRIOR_SHA, "Historical evidence pins changed")
+    prior = json.loads(p.read_text())
+    for path, digest in prior["files"].items():
+        require(sha(Path(path).read_bytes()) == digest, "Historical evidence changed")
+    require(prior["sourceAfter"] == source, "Historical source differs")
+    for stage in prior["staticStages"]:
+        r = json.loads((D / "run" / (stage + ".exit.json")).read_text())
+        require(r["exit"] == 0 and r["supervisorExit"] == 0 and r["sourceUnchanged"]
+                and r["sourceSha256After"] == source and not r["errors"], "Prior static stage failed")
+    r = json.loads((D / "run/events-positive.exit.json").read_text())
+    require(r["exit"] == 0 and r["supervisorExit"] == 1 and r["sourceUnchanged"]
+            and r["errors"] == ["result-adjudication:RuntimeError"]
+            and not r["timeout"] and not r["forcedCleanup"], "Unexpected prior outcome")
+    report = json.loads((D / "run/events-positive.json").read_text())
+    cases = [a for f in report["testResults"] for a in f["assertionResults"]]
+    executed = [a for a in cases if a["status"] not in ["pending", "skipped", "todo"]]
+    require(len(executed) == 4 and all(a["status"] == "passed" for a in executed)
+            and sorted(a["fullName"] for a in executed) == sorted(prior["actualPassed"]), "Actual four passes changed")
+    require(sorted(a["fullName"] for a in cases if a["fullName"].startswith("captures immutable") and a["status"] == "skipped")
+            == sorted(prior["actualSkippedOwners"]), "Skipped owner partition changed")
+    require(report["success"] and report["numPassedTests"] == 4 and report["numFailedTests"] == 0
+            and not report.get("unhandledErrors") and not report.get("errors"), "Prior JSON errors")
+    require(not (D / "run/sse-regression.started.json").exists(), "SSE already attempted in original run")
