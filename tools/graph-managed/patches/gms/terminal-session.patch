+type terminalListener struct {
+	*bufconn.Listener
+	mu       sync.Mutex
+	accepted []*terminalTransport
+}
+
+func (l *terminalListener) Accept() (net.Conn, error) {
+	c, err := l.Listener.Accept()
+	if err != nil {
+		return nil, err
+	}
+	owned := &terminalTransport{Conn: c, closed: make(chan struct{})}
+	l.mu.Lock()
+	l.accepted = append(l.accepted, owned)
+	l.mu.Unlock()
+	return owned, nil
+}
+func (l *terminalListener) transports() []*terminalTransport {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return append([]*terminalTransport(nil), l.accepted...)
+}
