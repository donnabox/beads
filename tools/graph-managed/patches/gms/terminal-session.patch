+// Direct Connector.Connect, never sql.OpenDB: no pool/reset/reconnect. The
+// positive packet limit avoids SELECT @@max_allowed_packet. NewConfig has no
+// Params, Charset or BeforeConnect hook; no option installs one. Close sends
+// COM_QUIT, not SQL. MySQLDb is disabled: this is not password verification.
+func (f *terminalFixture) connect(t *testing.T) error {
+	t.Helper()
+	cfg := mysqlclient.NewConfig()
+	cfg.User, cfg.Net, cfg.Addr = "root", "tcp", "bufconn"
+	cfg.MaxAllowedPacket = 64 << 10
+	cfg.Timeout, cfg.ReadTimeout, cfg.WriteTimeout = terminalIOBound, terminalIOBound, terminalIOBound
+	cfg.DialFunc = func(ctx context.Context, _, _ string) (net.Conn, error) { return f.dial(ctx) }
+	connector, err := mysqlclient.NewConnector(cfg)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), terminalIOBound)
+	defer cancel()
+	f.client, err = connector.Connect(ctx)
+	if err != nil {
+		return err
+	}
+	terminalAwait(t, f.observer.newDone, "client NewConnection/AddConn")
+	return err
+}
