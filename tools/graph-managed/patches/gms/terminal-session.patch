+// existingContextForClose captures a session without creating one. It is not a
+// concurrent close claim; the caller retains the connection lifecycle ownership.
+func (s *SessionManager) existingContextForClose(ctx context.Context, conn *mysql.Conn) (*sql.Context, bool) {
