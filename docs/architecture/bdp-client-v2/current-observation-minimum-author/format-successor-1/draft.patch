+          parseTypeDescriptor({
+            id: linkType,
+            name: "Relation",
+            describes: "link",
+            conformsTo: [],
+            source: { conformsTo: [beadType], external: "opaque" },
+            target: { conformsTo: [beadType], external: "opaque" },
+          }),
+        ],
+        credentials: [
+          { token, principal: "p", canMutate: true },
