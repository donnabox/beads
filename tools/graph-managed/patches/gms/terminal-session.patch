+// releaseExistingSessionLocks never creates a session during terminal cleanup.
+// An absent session skips the connID table sweep; this does not settle stale
+// table-lock debt or resources acquired by a failed custom builder.
+func (h *Handler) releaseExistingSessionLocks(c *mysql.Conn) {
+	ctx, ok := h.sm.existingContextForClose(context.Background(), c)
+	if !ok {
+		return
+	}
+	h.releaseAllLocks(ctx, c.ConnectionID)
+}
+
+func (h *Handler) releaseAllLocks(ctx *sql.Context, connID uint32) {
+	_, err := h.e.LS.ReleaseAll(ctx)
+	if err != nil {
+		logrus.Errorf("unable to release all locks on session close: %s", err)
+	}
+	if err = h.e.Analyzer.Catalog.UnlockTables(ctx, connID); err != nil {
+		logrus.Errorf("unable to unlock tables on session close: %s", err)
 	}
