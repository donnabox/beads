+    ajv.addSchema(bundle);
+    const problem = ajv.compile({ $ref: `${bundle.$id}#/$defs/transactionalProblem` });
+    const pageValidator = ajv.compile({ $ref: `${bundle.$id}#/$defs/eventPage` });
+    runtime = await startTransactionRuntime(
