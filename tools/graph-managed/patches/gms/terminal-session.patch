+type terminalFixture struct {
+	listener                                        *terminalListener
+	observer                                        *terminalObserved
+	engine                                          *sqle.Engine
+	server                                          *Server
+	handler                                         *Handler
+	raw                                             *terminalTransport
+	client                                          driver.Conn
+	watch                                           *connState
+	started                                         bool
+	dialOnce                                        sync.Once
+	acceptDone                                      chan struct{}
+	acceptErr                                       error
+	clientOnce, serverOnce, cleanupOnce, finishOnce sync.Once
+	clientErr, serverErr, cleanupErr, finishErr     error
+	cleanupDone                                     chan struct{}
+}
