+{
+  "_comment": "Review-only final graph literals, not import/transaction syntax. Eight definitions and four owned declarations. Type, BeadType and LinkType are affiliated with BeadType; ConformsTo is affiliated with LinkType. Trusted seed installation and revision allocation remain open. IDs/revisions are placeholders. No implicit affiliation edges. Conformance is acyclic over exact revisions; generic identity-based acyclic is deliberately not enabled on ConformsTo pending the same-identity revision decision.",
+  "definitions": [
+    {
+      "id": "https://example.org/types/beads/type",
+      "revision": "type-1",
+      "type": {
+        "uri": "https://example.org/types/beads/bead-type",
+        "revision": "bead-type-1"
+      },
+      "properties": {
+        "propertiesSchema": {
+          "$schema": "https://json-schema.org/draft/2020-12/schema",
+          "$id": "https://example.org/bdp-draft/schemas/type-definition.properties.schema.json",
+          "title": "Common Type descriptor properties",
+          "$comment": "Review candidate. This is the properties schema of Type and therefore the common descriptor schema. Affiliation with BeadType or LinkType supplies category-specific validation. Shape validation is not Type admission.",
+          "type": "object",
+          "required": ["propertiesSchema"],
+          "properties": {
+            "description": {
+              "type": "string"
+            },
+            "propertiesSchema": {
+              "allOf": [
