+type terminalObserved struct {
+	mu                                                           sync.Mutex
+	conn                                                         *mysql.Conn
+	connections, authenticated, closedCalls, builders, factories int
+	connectedEvents, disconnectedEvents, queryEvents             int
+	aborts                                                       []string
+	authErr                                                      error
+	created                                                      *terminalMemorySession
+	contextSessions                                              []sql.Session
+	newDone, closed                                              chan struct{}
+	newOnce, closedOnce                                          sync.Once
+}
+
+// This wrapper forwards mysql.Handler only. It must not be reused for query or
+// replica tests without also forwarding ExtendedHandler/BinlogReplicaHandler.
+type terminalHandler struct {
+	mysql.Handler
+	o *terminalObserved
+}
+
+func (h *terminalHandler) NewConnection(c *mysql.Conn) {
+	h.Handler.NewConnection(c)
+	h.o.mu.Lock()
+	h.o.conn = c
+	h.o.connections++
+	h.o.mu.Unlock()
+	h.o.newOnce.Do(func() { close(h.o.newDone) })
+}
+func (h *terminalHandler) ConnectionAuthenticated(c *mysql.Conn) error {
+	h.o.mu.Lock()
+	h.o.authenticated++
+	h.o.mu.Unlock()
+	err := h.Handler.ConnectionAuthenticated(c)
+	h.o.mu.Lock()
+	h.o.authErr = err
+	h.o.mu.Unlock()
+	return err
+}
+func (h *terminalHandler) ConnectionAborted(c *mysql.Conn, reason string) error {
+	err := h.Handler.ConnectionAborted(c, reason)
+	h.o.mu.Lock()
+	h.o.aborts = append(h.o.aborts, reason)
+	h.o.mu.Unlock()
+	return err
+}
+func (h *terminalHandler) ConnectionClosed(c *mysql.Conn) {
+	h.Handler.ConnectionClosed(c)
+	h.o.mu.Lock()
+	h.o.closedCalls++
+	h.o.mu.Unlock()
+	// Signal only after the real delegate and all its defers returned normally.
+	h.o.closedOnce.Do(func() { close(h.o.closed) })
+}
